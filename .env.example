# Magic Mug POS - Environment Configuration

# Application
APP_NAME="MAGIC MUG POS"
ENV="development"
PORT=8000
DEBUG=True

# Database Configuration (PostgreSQL Async)
DATABASE_URL="postgresql+asyncpg://pos_user:super_secure_pos_password@localhost:5432/magic_mug_pos"

# PostgreSQL Container Credentials (used by Docker Compose)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=magic_mug_pos
POSTGRES_USER=pos_user
POSTGRES_PASSWORD=super_secure_pos_password

# Security Configuration
SECRET_KEY="magic-mug-super-secret-key-change-in-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=720

# CORS Configuration
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173"
